{
  "schemaVersion": 1,
  "id": "cosmos.menu",
  "name": "Cosmos Menu Drawer",
  "version": "1.0.0",
  "author": "Javier Pastor",
  "description": "Omarchy menu with configurable Left/Right full-height drawer, Top/Bottom slide, and Centre modes.",
  "omarchy": {
    "clonedFrom": "omarchy.menu"
  },
  "kinds": [
    "menu",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "menu": "Menu.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Cosmos Menu",
    "description": "Launches the Cosmos drawer menu",
    "category": "Compositor",
    "allowMultiple": false
  }
}
